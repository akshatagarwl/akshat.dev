{
  "name": "akshat-dev",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "prepare-content": "bun scripts/prepare-content.ts",
    "dev": "bun run prepare-content && NEXT_TELEMETRY_DISABLED=1 next dev --hostname 127.0.0.1 --port 4321",
    "build": "bun run prepare-content && bun run test:engine && NEXT_TELEMETRY_DISABLED=1 next build",
    "preview": "WRANGLER_SEND_METRICS=false node node_modules/wrangler/bin/wrangler.js dev --local --ip 127.0.0.1 --port 4321",
    "check": "bun run prepare-content && NEXT_TELEMETRY_DISABLED=1 next typegen && tsc --noEmit",
    "test": "playwright test",
    "test:engine": "node scripts/test-seedbed.mjs && bun scripts/test-travels.tsx",
    "render:garden": "node scripts/render-garden.mjs",
    "deploy": "bun run build && WRANGLER_SEND_METRICS=false node node_modules/wrangler/bin/wrangler.js deploy"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "lucide-react": "1.73.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "6.0.3",
    "wrangler": "4.162.0"
  }
}
